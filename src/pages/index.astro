---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentWorks } from '@/lib/data-utils'

const works = await getRecentWorks(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="rounded-lg border">
    <div class="flex flex-col space-y-1.5 p-6">
      <h3 class="text-3xl leading-none font-medium">Khoi</h3>
      <p class="text-muted-foreground text-sm">
        /ˈkoʊ/ &bull; <span class="font-medium">noun</span>
      </p>
    </div>
    <div class="p-6 pt-0">
      <p class="text-muted-foreground mb-2 text-sm">
        Khoi is the curious person. Asking, and answering 
        the outstanding things by self-taught, why?. 
        The reason people need knowledge because of the questions in our mind.
        And, He takes advantage of human survival instinct to study,
        that is curious!
      </p>
      <p class="text-muted-foreground mb-2 text-sm">
        Majors: Design Engineer
      </p>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest works</h2>
    <ul class="flex flex-col gap-y-4">
      {
        works.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/work"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all works <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
